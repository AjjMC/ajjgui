# Optional self-contained example demonstrating programmatic GUI registration & callbacks.
# Call manually: /function ajjguil:demo/register_examples

# 1. 27-slot interactive shop GUI
data modify storage ajjguil:input gui set value {id:"ajjguil:demo_shop",size:27,custom_name:{text:"AjjGUIL Demo Shop",color:"gold"},persistent:1b,callbacks:{on_click:"ajjguil:demo/on_shop_click",on_open:"ajjguil:demo/on_shop_open"},pages:[[{Slot:11b,id:"minecraft:diamond_sword",count:1,components:{"minecraft:custom_name":{text:"Buy Diamond Sword",color:"aqua"},"minecraft:lore":[{text:"Price: 10 Gold",color:"gray"}], "minecraft:custom_data":{ajjguil:{widget:"button",id:"buy_sword",data:{price:10}}}}},{Slot:13b,id:"minecraft:lever",count:1,components:{"minecraft:custom_name":{text:"Auto-Equip: OFF",color:"red"},"minecraft:custom_data":{ajjguil:{widget:"switch",id:"auto_equip",items:[{id:"minecraft:lever",count:1,components:{"minecraft:custom_name":{text:"Auto-Equip: OFF",color:"red"}}},{id:"minecraft:redstone_torch",count:1,components:{"minecraft:custom_name":{text:"Auto-Equip: ON",color:"green"}}}]}}}},{Slot:15b,id:"minecraft:hopper",count:1,components:{"minecraft:custom_name":{text:"Sell / Recycle Item",color:"yellow"},"minecraft:custom_data":{ajjguil:{widget:"itembin",id:"recycle"}}}},{Slot:26b,id:"minecraft:barrier",count:1,components:{"minecraft:custom_name":{text:"Close",color:"red"},"minecraft:custom_data":{ajjguil:{widget:"button",exit:1b}}}}]]}
function ajjguil:api/register

# 2. 54-slot double-chest vault GUI
data modify storage ajjguil:input gui set value {id:"ajjguil:demo_vault",size:54,custom_name:{text:"54-Slot Vault",color:"dark_purple"},persistent:1b,pages:[[{Slot:4b,id:"minecraft:ender_chest",count:1,components:{"minecraft:custom_name":{text:"Vault Page 1",color:"light_purple"},"minecraft:custom_data":{ajjguil:{widget:"button",id:"vault_info"}}}},{Slot:49b,id:"minecraft:arrow",count:1,components:{"minecraft:custom_name":{text:"Next Page ->",color:"green"},"minecraft:custom_data":{ajjguil:{widget:"button",page:1,relative:1b}}}},{Slot:53b,id:"minecraft:barrier",count:1,components:{"minecraft:custom_name":{text:"Close",color:"red"},"minecraft:custom_data":{ajjguil:{widget:"button",exit:1b}}}}],[{Slot:4b,id:"minecraft:nether_star",count:1,components:{"minecraft:custom_name":{text:"Vault Page 2",color:"gold"},"minecraft:custom_data":{ajjguil:{widget:"button"}}}},{Slot:45b,id:"minecraft:arrow",count:1,components:{"minecraft:custom_name":{text:"<- Prev Page",color:"yellow"},"minecraft:custom_data":{ajjguil:{widget:"button",page:-1,relative:1b}}}}]]}
function ajjguil:api/register
