+execute unless data storage ajjguil:data {api_ready:1b} run return fail
+
+# 1. 54-slot Double Chest / Double Copper Chest Block GUI (2 pages)
+data modify storage ajjguil:input gui set value {id:"example:block_vault",namespace:"example",size:54,custom_name:{text:"Block Vault (54-slot)",color:"dark_purple"},persistent:1b,pages:[[{Slot:4b,id:"minecraft:ender_chest",count:1,components:{"minecraft:custom_name":{text:"Inspect Container Info",color:"light_purple"},"minecraft:lore":[{text:"Reads api/get_info at runtime",color:"gray"}],"minecraft:custom_data":{ajjguil:{widget:"button",id:"inspect_vault",callback:"example:block/inspect_info"}}}},{Slot:20b,id:"minecraft:chest",count:1,components:{"minecraft:custom_name":{text:"Vault Deposit Slot A",color:"yellow"},"minecraft:custom_data":{ajjguil:{widget:"itemslot",id:"vault_slot_a",size:64,placeholder:{id:"minecraft:chest",count:1,components:{"minecraft:custom_name":{text:"Vault Deposit Slot A",color:"yellow"}}}}}}},{Slot:24b,id:"minecraft:chest",count:1,components:{"minecraft:custom_name":{text:"Vault Deposit Slot B",color:"yellow"},"minecraft:custom_data":{ajjguil:{widget:"itemslot",id:"vault_slot_b",size:64,placeholder:{id:"minecraft:chest",count:1,components:{"minecraft:custom_name":{text:"Vault Deposit Slot B",color:"yellow"}}}}}}},{Slot:31b,id:"minecraft:hopper",count:1,components:{"minecraft:custom_name":{text:"Vault Incinerator",color:"red"},"minecraft:custom_data":{ajjguil:{widget:"itembin",id:"vault_trash"}}}},{Slot:49b,id:"minecraft:arrow",count:1,components:{"minecraft:custom_name":{text:"Page 2 ->",color:"green"},"minecraft:custom_data":{ajjguil:{widget:"button",id:"vault_next",page:1,relative:1b}}}},{Slot:53b,id:"minecraft:barrier",count:1,components:{"minecraft:custom_name":{text:"Close Vault",color:"red"},"minecraft:custom_data":{ajjguil:{widget:"button",id:"vault_exit",exit:1b,fixed:1b}}}}],[{Slot:4b,id:"minecraft:name_tag",count:1,components:{"minecraft:custom_name":{text:"Rename Vault Title",color:"gold"},"minecraft:custom_data":{ajjguil:{widget:"button",id:"vault_rename",callback:"example:block/rename_vault"}}}},{Slot:22b,id:"minecraft:nether_star",count:1,components:{"minecraft:custom_name":{text:"Vault Settings Page",color:"gold"},"minecraft:custom_data":{ajjguil:{widget:"button",id:"vault_settings"}}}},{Slot:45b,id:"minecraft:arrow",count:1,components:{"minecraft:custom_name":{text:"<- Page 1",color:"yellow"},"minecraft:custom_data":{ajjguil:{widget:"button",id:"vault_prev",page:-1,relative:1b}}}}]]}
+function ajjguil:api/register
+
+# 2. 9-slot Processing Station GUI (Crafter / Dispenser / Dropper)
